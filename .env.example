# ============================================================
# FreshGuard AI — Environment Configuration Template
# Do NOT commit production API keys or credentials to Git.
# ============================================================

# ─── Frontend (Vite) ───────────────────────────────────────
# Google Gemini AI Studio API Key
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Open Food Facts User Agent Header (Required for barcode registry compliance)
VITE_OFF_USER_AGENT=FreshGuardAI/1.0 (operations@freshbasket.example)

# Backend API base URL (leave blank to use relative /api/v1 path on same domain)
VITE_API_BASE_URL=

# Deployment environment
VITE_APP_ENV=production

# ─── Backend / Server ──────────────────────────────────────
# Full Prisma PostgreSQL connection string (required for backend features)
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres

# Long random string used to sign JWT tokens
JWT_SECRET=change-me-to-a-long-random-secret

# Server port (local dev only)
PORT=5000
NODE_ENV=development

# Gemini API key for server-side AI services
GEMINI_API_KEY=your-gemini-api-key-here
