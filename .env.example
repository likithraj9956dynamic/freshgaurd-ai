# ============================================================
# FreshGuard AI — Environment Configuration Template
# Do NOT commit production API keys or credentials to Git.
# ============================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret for Session Signatures
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# Initial Main Manager Setup Bootstrap Secret (Required for 1st Main Manager registration only)
INITIAL_MANAGER_SETUP_SECRET=987654321

# Transactional Email Service (Resend / SendGrid / SMTP provider)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=FreshGuard AI <notifications@freshguard.ai>
APP_BASE_URL=https://freshguard-ai-henna.vercel.app

# Google Gemini AI Studio API Key (Optional: Can also be configured securely in-app under Settings)
VITE_GEMINI_API_KEY=

# OpenAI API Key (Optional: Alternative intelligence provider)
VITE_OPENAI_API_KEY=

# Open Food Facts User Agent Header (Required for barcode registry compliance)
VITE_OFF_USER_AGENT=FreshGuardAI/1.0 (operations@freshbasket.example)

# Deployment Base URL / Environment Identifier
VITE_APP_ENV=production
